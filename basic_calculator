def add(num1,num2):
    return num1+num2
def sub(num1,num2):
    return num1-num2
def mult(num1,num2):
    return num1*num2
def divi(num1,num2):
    return num1/num2
def avg(num1,num2):
    return (num1+num2)/2
print("please select operation:\n""1. Addition\n""2. Subtraction\n""3. Multiplication\n""4. Division\n""5.Average")
select =int(input("selcet a operation from 1,2,3,4,5:"))
num1=int(input("enter first number:"))
num2=int(input("enter second number:"))
if(select==1):
    print(num1,"+",num2,"=", add(num1,num2))
elif(select==2):
    print(num1,"-",num2,"=", sub(num1,num2))
elif(select==3):
    print(num1,"*",num2,"=", mult(num1,num2))
elif(select==4):
    print(num1,"/",num2,"=", divi(num1,num2))
elif(select==5):
    print("(",num1,"+",num2,")","/","2","=", avg(num1,num2))
